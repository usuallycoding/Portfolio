# Copy to .env (docker compose) or enter these values in the Portainer stack's environment variables.

# Required: the owner's admin password.
PORTFOLIO_PASSWORD=change-me

# Required: the GitHub account or organisation that owns the images (ghcr.io/<owner>/portfolio-*), in lower case.
GHCR_OWNER=your-github-name

# Image tag to run: latest, or a release tag such as v1.0.0 to pin a version.
IMAGE_TAG=latest

# Host ports. The client is the public site (point the Cloudflare tunnel at it); the admin is for the local network only.
CLIENT_PORT=3000
ADMIN_PORT=8081

# Optional: publish the admin only on this host address (e.g. the Raspberry Pi's LAN address). Default: all interfaces.
# ADMIN_BIND=192.168.1.20

# Optional: server memory. SERVER_HEAP is the JVM heap, SERVER_MEMORY the container limit; keep the limit above the heap.
# SERVER_HEAP=512m
# SERVER_MEMORY=768m
